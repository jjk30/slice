# Terminate HTTPS and reverse-proxy to the gateway container.
# Phase 17: the api host blocks the /metrics path publicly (Prometheus scrapes the
# gateway internally over the compose network, never through Caddy), and a second
# site serves Grafana. The hostnames are read from the environment ({$API_DOMAIN} /
# {$GRAFANA_DOMAIN}), passed to the caddy container by compose — so this file is static.
{$API_DOMAIN} {
    # /metrics is internal-only: return 404 to the public internet so the gateway's
    # Prometheus endpoint is never exposed here. The internal scrape hits
    # gateway:8080/metrics directly and bypasses Caddy entirely.
    @metrics path /metrics /metrics/*
    respond @metrics 404

    reverse_proxy gateway:8080
}

{$GRAFANA_DOMAIN} {
    reverse_proxy grafana:3000
}

# Marketing site on the apex domain. The static website/ folder is mounted into this
# container at /srv/slice-site (see docker-compose.yml); Caddy serves it and gets a
# Let's Encrypt cert automatically once the root A record points here. The apex is the
# product's own fixed domain, so it is written literally rather than read from the
# environment (unlike the api/grafana hosts, which are reused across deploys).
sliceapp.dev {
    root * /srv/slice-site
    file_server
    encode zstd gzip
}

# Send www to the bare apex, keeping the path and query, as a permanent redirect.
www.sliceapp.dev {
    redir https://sliceapp.dev{uri} permanent
}
