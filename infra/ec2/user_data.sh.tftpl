#!/bin/bash
# ===========================================================================
# slice cheap always-on box bootstrap (small: config lives in S3, not inline).
#
# Rendered by Terraform (templatefile): the dollar-brace tokens below are
# Terraform template vars, substituted at render time. Bash variables are
# written WITHOUT braces (e.g. $ANTHROPIC_API_KEY) so Terraform leaves them
# alone and the shell expands them at boot.
#
# The bulky, static config (docker-compose.yml, Caddyfile, prometheus.yml, the
# grafana provisioning tree) lives in a private S3 bucket and is pulled with
# `aws s3 sync` — this keeps the rendered user_data well under AWS's 16KB limit.
# Secrets are NEVER in S3: they are fetched from Secrets Manager here and written
# into /opt/slice/.env and /opt/slice/grafana.env at boot. The Postgres password
# is its own secret (slice/ec2-db), so it is never inlined into the rendered
# user_data or the compose file — it is fetched here and passed to compose via the
# shell environment (compose interpolates $${POSTGRES_PASSWORD} from it).
#
# Idempotent and safe to re-run: it re-syncs config, re-writes the env files, and
# runs `docker compose up -d`. The named Postgres volume survives restarts, and the
# gateway image self-applies DB migrations on startup (app/db.py).
# ===========================================================================
set -euxo pipefail
exec > >(tee -a /var/log/slice-bootstrap.log) 2>&1

REGION="${aws_region}"
ECR_REGISTRY="${ecr_registry}"
SECRET_NAME="${app_secret_name}"
DB_SECRET_NAME="${db_secret_name}"
CONFIG_BUCKET="${config_bucket}"

# --- Docker + jq -----------------------------------------------------------
dnf install -y docker jq
systemctl enable --now docker

# --- Docker compose plugin (AL2023 has no compose package; drop the arm64
#     binary into the CLI plugins dir) ------------------------------------
COMPOSE_VERSION="v2.29.7"
install -d /usr/libexec/docker/cli-plugins
curl -fsSL \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-aarch64" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# --- 2GB swap (small box; keep it from OOMing under image pulls/builds) -----
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- ECR login -------------------------------------------------------------
aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$ECR_REGISTRY"

# --- Pull secrets from Secrets Manager -------------------------------------
# Two secrets: the app secret (Anthropic key, JWT, optional alert/scanner config)
# and the DB secret (just the Postgres password, so it is never in git or state's
# user_data).
SECRET_JSON="$(aws secretsmanager get-secret-value \
  --region "$REGION" --secret-id "$SECRET_NAME" \
  --query SecretString --output text)"
DB_SECRET_JSON="$(aws secretsmanager get-secret-value \
  --region "$REGION" --secret-id "$DB_SECRET_NAME" \
  --query SecretString --output text)"

ANTHROPIC_API_KEY="$(echo "$SECRET_JSON" | jq -r '.ANTHROPIC_API_KEY')"
JWT_SECRET="$(echo "$SECRET_JSON" | jq -r '.JWT_SECRET')"
# Default to "" so a missing key writes an empty value instead of failing.
GITHUB_OAUTH_CLIENT_ID="$(echo "$SECRET_JSON" | jq -r '.GITHUB_OAUTH_CLIENT_ID // ""')"
# Phase 17: Grafana admin password. Read from the same app secret; falls back to
# "admin" if the key is absent so a fresh deploy still boots (change it via the secret).
GRAFANA_ADMIN_PASSWORD="$(echo "$SECRET_JSON" | jq -r '.GRAFANA_ADMIN_PASSWORD // "admin"')"
# Phase 11 alerts + phase 18b scanner template URL. Each defaults to "" so a missing key
# writes nothing; the conditional appends below skip empty values entirely.
RESEND_API_KEY="$(echo "$SECRET_JSON" | jq -r '.RESEND_API_KEY // ""')"
ALERT_EMAIL_TO="$(echo "$SECRET_JSON" | jq -r '.ALERT_EMAIL_TO // ""')"
ALERT_FROM="$(echo "$SECRET_JSON" | jq -r '.ALERT_FROM // ""')"
ALERTS_ENABLED="$(echo "$SECRET_JSON" | jq -r '.ALERTS_ENABLED // ""')"
SCANNER_TEMPLATE_URL="$(echo "$SECRET_JSON" | jq -r '.SCANNER_TEMPLATE_URL // ""')"
POSTGRES_PASSWORD="$(echo "$DB_SECRET_JSON" | jq -r '.POSTGRES_PASSWORD')"

# --- Config from S3 --------------------------------------------------------
# docker-compose.yml, Caddyfile, prometheus.yml, and the grafana/ provisioning
# tree. No --delete, so the env files written below are never removed.
install -d /opt/slice
aws s3 sync "s3://$CONFIG_BUCKET/" /opt/slice/

# Values the S3-synced files need at `docker compose up`: compose interpolates
# $${POSTGRES_PASSWORD}/$${DB_USERNAME}/$${DB_NAME}/$${GATEWAY_IMAGE} in docker-compose.yml,
# and passes API_DOMAIN/GRAFANA_DOMAIN into the caddy container (its Caddyfile reads
# them with {$...}). Exported so `docker compose` sees them in the environment.
export POSTGRES_PASSWORD
export DB_USERNAME="${db_username}"
export DB_NAME="${db_name}"
export GATEWAY_IMAGE="${gateway_image}"
export API_DOMAIN="${api_domain}"
export GRAFANA_DOMAIN="${grafana_domain}"

# --- Secret env files (never in S3) ----------------------------------------
# .env — the env vars the gateway expects, DATABASE_URL embedding the Postgres password
# fetched above (never rendered into user_data or the compose file). It ALSO carries the
# six compose-interpolation vars (POSTGRES_PASSWORD/DB_USERNAME/DB_NAME/GATEWAY_IMAGE/
# API_DOMAIN/GRAFANA_DOMAIN) plus AWS_REGION: the boot shell exports them (below/above),
# but a later manual `docker compose` over SSM has no such exports — compose auto-reads
# this .env, so those runs resolve $${...} too instead of failing with "no image specified".
cat > /opt/slice/.env <<EOF
DATABASE_URL=postgresql://$DB_USERNAME:$POSTGRES_PASSWORD@postgres:5432/$DB_NAME
REDIS_URL=redis://redis:6379
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
JWT_SECRET=$JWT_SECRET
GITHUB_OAUTH_CLIENT_ID=$GITHUB_OAUTH_CLIENT_ID
AWS_REGION=$REGION
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DB_USERNAME=$DB_USERNAME
DB_NAME=$DB_NAME
GATEWAY_IMAGE=$GATEWAY_IMAGE
API_DOMAIN=$API_DOMAIN
GRAFANA_DOMAIN=$GRAFANA_DOMAIN
EOF
# Optional alert + scanner settings: appended only when present in the secret, so an
# unset key leaves the gateway on its own defaults instead of writing an empty override.
[ -n "$RESEND_API_KEY" ] && echo "RESEND_API_KEY=$RESEND_API_KEY" >> /opt/slice/.env
[ -n "$ALERT_EMAIL_TO" ] && echo "ALERT_EMAIL_TO=$ALERT_EMAIL_TO" >> /opt/slice/.env
[ -n "$ALERT_FROM" ] && echo "ALERT_FROM=$ALERT_FROM" >> /opt/slice/.env
[ -n "$ALERTS_ENABLED" ] && echo "ALERTS_ENABLED=$ALERTS_ENABLED" >> /opt/slice/.env
[ -n "$SCANNER_TEMPLATE_URL" ] && echo "SCANNER_TEMPLATE_URL=$SCANNER_TEMPLATE_URL" >> /opt/slice/.env
chmod 600 /opt/slice/.env

# grafana.env — kept SEPARATE from the app .env so the gateway's secrets never enter
# the Grafana container. Only the GF_* config Grafana reads directly.
cat > /opt/slice/grafana.env <<EOF
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=$GRAFANA_ADMIN_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false
GF_SERVER_ROOT_URL=https://$GRAFANA_DOMAIN
EOF
chmod 600 /opt/slice/grafana.env

# --- Launch ----------------------------------------------------------------
cd /opt/slice
docker compose pull
docker compose up -d
