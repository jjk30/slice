# Copy this file to k8s/secrets.env and fill in real values.
#   cp k8s/secrets.env.example k8s/secrets.env
#
# k8s/secrets.env is gitignored — it is never committed. kustomize's
# secretGenerator reads it and builds the `slice-secrets` Secret at deploy time.
# Format is KEY=VALUE, one per line, no quotes, no surrounding spaces.

# Postgres password. Must match the password embedded in DATABASE_URL below.
POSTGRES_PASSWORD=change-me

# Full connection string the gateway uses. Host is the in-cluster service name
# `postgres`; user and db are both `slice`. Keep the password in sync with
# POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://slice:change-me@postgres:5432/slice

# Signing key for slice's own JWTs (dashboard/session auth). Any long random
# string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic API key used by server-side helper calls (router judge, agent loop,
# guardrails, the cost scanner's LangGraph agent). Proxied client requests still
# use the caller's own x-api-key, not this. Leave as-is to run without them.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Resend API key for alert emails. Leave blank to disable email alerts.
RESEND_API_KEY=

# GitHub OAuth app client ID used for the device-flow login. Create an OAuth app
# at https://github.com/settings/developers and copy its Client ID here.
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
