# Keep the build context (and the image) lean: exclude anything the runtime
# doesn't need. Mirrors the "copy only what runs" rule in the Dockerfile.
.venv
.git
tests
# Phase 21: the dashboard SOURCE must reach the build stage (it is compiled there), so
# only keep the two build products out: the host's node_modules and any host build.
dashboard/node_modules
dashboard/dist
# A dev's local dashboard/.env can carry VITE_API_BASE_URL=http://localhost:8080, which
# Vite would bake into the production bundle. Keep it out of the build context (this exact
# pattern does not match .env.production / .env.example, which must reach the build stage).
dashboard/.env
.env
*.pyc
__pycache__
.pytest_cache
rag_store
.DS_Store
slice.egg-info
.claude
