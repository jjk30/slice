# The slice-gateway distribution is the CLI plus the standalone MCP server. Keep the sdist
# to those two, the PyPI readme, the license, and build metadata. Nothing else from the
# server repo (mcp_server is kept, so it is not pruned here).
prune tests
prune app
prune infra
prune k8s
prune dashboard
prune desktop
prune website
prune migrations
prune demo
prune scripts
prune guardrails
prune docs
prune gateway
prune pipeline
prune rag_store
exclude README.md
exclude requirements.txt
exclude docker-compose.yml
exclude Dockerfile
exclude pytest.ini
global-exclude *.pyc
global-exclude .DS_Store
