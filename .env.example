# slice gateway: placeholder values only, never real keys
ANTHROPIC_BASE_URL=https://api.anthropic.com
PORT=8080
# Leave unset to run without request logging.
DATABASE_URL=postgresql://slice:slice@localhost:5432/slice

# Server-side provider keys. Anthropic is not here: it always uses the client's
# own x-api-key. Leave a key unset to keep that provider off; a request routed to
# it gets a clean 401 and never leaves the machine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Redis layer (phase 4): cache, budget caps, rate limits. If Redis is
# unreachable every check fails open and the proxy keeps serving traffic.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_PER_MIN=60
BUDGET_MONTHLY_USD=25
BUDGET_WARN_RATIO=0.8
CACHE_TTL_SECONDS=3600

# Router (phase 5): pin beats rule beats auto. Auto-routing is the only stage this
# flag can disable; pins and per-team switch rules always apply. An "easy" verdict
# routes to ROUTE_EASY_MODEL; "hard" keeps the client's model. The judge is a tiny
# classifier call that fails safe to "hard" on any error, timeout, or odd reply.
AUTO_ROUTE_ENABLED=true
ROUTE_EASY_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-haiku-4-5-20251001
JUDGE_TIMEOUT_SECONDS=3
JUDGE_MAX_INPUT_CHARS=2000
RULES_REFRESH_SECONDS=30

# RAG retrieval (phase 6): semantic hint for the judge, built offline from past
# prompts by `python -m scripts.build_rag_index`. Runs only on the auto path and
# only informs the judge, never a hard rule. Off, or a missing index, is exactly
# phase-5 behavior. The index is per-team: rag_store/<team>/, so one team's history
# never feeds another team's hint. RAG_STORE_PROMPTS gates prompt logging (off by
# default; prompts can be sensitive). RAG_EMBED_MODEL sets the local model used at
# both build and query time: the two must match.
RAG_ENABLED=true
RAG_TOP_K=5
RAG_INDEX_DIR=rag_store
RAG_STORE_PROMPTS=false
RAG_EMBED_MODEL=all-MiniLM-L6-v2

# Agent loop (phase 7): try cheap, check, escalate, stop at a budget ceiling. The
# loop extends the auto path only: it fires when auto-routing sent a request DOWN
# to a cheaper model and the request is non-streaming. Pins, rules, cache hits, gate
# rejects, hard verdicts, and streams never loop (a qualifying stream is flagged
# x-slice-agent: off:stream and behaves exactly as phase 6). Every stage fails open.
AGENT_ENABLED=true
# The escalation ladder, cheap to strong, spanning providers. The first try is always
# the routed cheap model; escalation walks up from the rung above it (or straight to
# the final rung if it isn't listed). The client's requested model is always the final
# rung, appended if absent. Every rung must be priceable: an unknown price makes the
# cost estimate infinite and blocks that rung, never a silent zero.
AGENT_LADDER=claude-haiku-4-5-20251001,gemini-3.6-flash,gpt-5.2,claude-sonnet-5
# Hard cap on total attempts (first try plus escalations) for one request.
AGENT_MAX_ATTEMPTS=3
# Per-request spend ceiling across every attempt and checker call. Before each
# escalation an upper-bound estimate is computed; if spend-so-far plus that estimate
# would cross this, the attempt is skipped and the best answer in hand is served. The
# ceiling is never crossed.
AGENT_COST_CEILING_USD=0.25
# The model the checker uses to judge pass/fail on an answer. Defaults to the judge
# model. Tiny max_tokens; its cost counts toward the ceiling.
AGENT_CHECK_MODEL=claude-haiku-4-5-20251001
# Output-token count assumed for the cost estimate when a request omits max_tokens.
AGENT_DEFAULT_MAX_TOKENS=1024

# Evaluation (phase 8): score a sample of routed-down answers with RAGAS, fire-and-
# forget, off the request path. When a request was routed DOWN to a cheaper model (or
# the agent loop passed on a cheap rung), a fraction of those responses are scored in a
# detached background task, never awaited, every failure swallowed, the request path
# untouched. Scores land in the eval_scores table and surface at /admin/eval/summary.
# EVAL_SAMPLE_RATE is the whole switch: 0 disables evaluation entirely (nothing sampled,
# no scorer built, ragas never imported, startup unaffected); 1 scores every qualifying
# request; in between is the sampled fraction.
EVAL_SAMPLE_RATE=0.05
# A score at or above this passes, below fails; the pass rate is what the summary reports.
EVAL_PASS_THRESHOLD=0.7
# The RAGAS judge model, wired through langchain-anthropic. Defaults to the router judge
# model. Its cost is external (the provider bills the judge call), not on the team budget.
EVAL_JUDGE_MODEL=claude-haiku-4-5-20251001
# Ceiling on a single RAGAS metric call; a timeout is swallowed like any other failure.
EVAL_TIMEOUT_SECONDS=30
# ragas telemetry stalled about 120s per metric on macOS; disable it.
RAGAS_DO_NOT_TRACK=true

# LangSmith tracing (phase 8): observability for the LangGraph router and agent loop,
# driven entirely by LangChain's own env vars. With tracing false (default) or no API
# key, LangChain no-ops and slice runs exactly as before: no code path requires it.
# When on, runs group under LANGCHAIN_PROJECT. Never put a real key in this file.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=slice

# --- Guardrails (phase 9): NeMo self-check rails around the agent loop only ---
# Two rails wrap the phase-7 agent loop and ONLY the loop (the non-streaming,
# auto-routed-down path); plain proxy traffic and the router path never touch them. An
# input rail self-checks the prompt for attempts to manipulate slice itself; an output
# rail self-checks the assembled final answer for leaked slice internals. Everything
# fails open: any error or timeout is logged and the loop proceeds as if the rail passed.
# GUARDRAILS_ENABLED is the whole kill switch: false means zero rails code runs, the loop
# behaves exactly as phase 7, and (because nemoguardrails is imported lazily) the server
# starts even if nemoguardrails is broken or absent.
GUARDRAILS_ENABLED=true
# The rails LLM, wired through langchain-anthropic. Defaults to the router judge model.
# Its calls are slice's own infrastructure cost, out-of-band from the team budget.
GUARDRAILS_MODEL=claude-haiku-4-5-20251001
# Ceiling on a single rail check; a timeout is swallowed like any other failure (fail open).
GUARDRAILS_TIMEOUT_SECONDS=5

# --- Alerts (phase 11): email when a team crosses its budget warn line or its cap ---
# The Redis layer already detects both moments (the once-per-month 80% warn latch and
# the cap-hit block); the alerts engine hangs off those exact spots, fire-and-forget:
# a detached task, every failure caught and logged, never on the request path. One
# channel for now, email via Resend. Slack and WhatsApp plug into the same channel
# interface later. ALERTS_ENABLED is unset by default: it then follows RESEND_API_KEY
# (on when the key is set, off when blank). Uncomment to force it either way. Note a
# blank value counts as false, like every other boolean flag here. Placeholders only,
# never a real key.
# ALERTS_ENABLED=true
RESEND_API_KEY=
# The sender. Resend's onboarding address works with no verified domain (delivers only
# to the Resend account owner's own email); use a verified-domain sender for real use.
ALERT_FROM=onboarding@resend.dev
# Where alerts go, comma-separated for more than one recipient.
ALERT_EMAIL_TO=
# Minimum seconds between two alerts of the same kind for the same team. The latch is
# the Redis key alert:cooldown:{team}:{kind}; Redis down fails open to sending.
ALERT_COOLDOWN_SECONDS=3600
# IANA zone for the timestamp in the alert text, e.g. "Aug 18, 2026, 3:20 AM EDT".
ALERT_TIMEZONE=America/New_York

# WhatsApp alerts via Twilio (phase 13, part 1): a second outbound channel that fires
# off the same cooldown as email. All four are optional: leave any blank and the
# WhatsApp channel is silently disabled (email, if configured, still sends). Outbound
# only; no inbound webhook. Placeholders only, never a real Account SID or token.
# Twilio Account SID (the "AC..." id from the Twilio console).
TWILIO_ACCOUNT_SID=
# Twilio Auth Token (paired with the SID as HTTP basic auth; keep it secret).
TWILIO_AUTH_TOKEN=
# The WhatsApp-enabled Twilio sender number, in whatsapp:+E164 form.
TWILIO_WHATSAPP_FROM=whatsapp:+17372324091
# Where WhatsApp alerts go, in whatsapp:+E164 form.
TWILIO_WHATSAPP_TO=whatsapp:+13128520631

# --- Auth (phase 12): GitHub device-flow login, slice keys, JWT dashboard sessions ---
# The lock. On (the default) the proxy paths and every /admin and /dashboard path
# require a valid slice key resolved to an account, the tenant every counter, cache
# key, log row and read is scoped by. Off is single-tenant LOCAL mode: no key required,
# everything runs under one local account (the pre-phase-12 behavior). Off is for local
# development ONLY, never expose an unlocked gateway. Secure by default (unset = on).
# AUTH_ENABLED=true
#
# The GitHub OAuth App client id slice logs in through. Public (device flow needs no
# client secret), but slice's own: create an OAuth App and paste its client id here.
# Unset means login is off (/auth/device/start answers 503). Never a real value in git.
GITHUB_OAUTH_CLIENT_ID=
# The OAuth App client secret, for the dashboard's browser GitHub sign-in (phase 21). Web
# login is configured only when this AND the client id are both set; device flow needs
# only the id. Secret: never a real value in git.
GITHUB_OAUTH_CLIENT_SECRET=
# The public origin the browser reaches slice at; the GitHub redirect_uri is this plus
# "/auth/github/callback" and must match the OAuth App's registered callback URL.
PUBLIC_BASE_URL=http://localhost:8080
#
# The HMAC secret the dashboard-session JWTs are signed with. Env only, never in code.
# Unset means no JWT is minted (login still returns a slice key; the JWT comes back
# null) and every presented JWT is rejected. Set a long random string in real use.
JWT_SECRET=
# How long a minted session JWT lives, in seconds (default 8 hours).
JWT_TTL_SECONDS=28800
# How long a resolved slice key -> account is cached in-process before Postgres is
# re-read. Bounds how long a freshly revoked key keeps working; same idea as the rules cache.
AUTH_KEY_CACHE_SECONDS=30
# Where the `slice` CLI points by default (login / init / the env lines `slice use` prints).
SLICE_BASE_URL=http://localhost:8080

# --- Dashboard (phase 10): local read endpoints + live SSE stream ---
# Browser origins allowed to call the gateway (CORS), comma-separated. The default is
# the Vite dev server the dashboard runs on (`npm run dev` in dashboard/). The built
# dashboard (`npm run build` -> dashboard/dist) is served by the gateway itself at "/"
# and needs no CORS. Since phase 12 every /dashboard/* read needs a slice key; keep this
# list to the origins you actually serve the dashboard from.
CORS_ORIGINS=http://localhost:5173
